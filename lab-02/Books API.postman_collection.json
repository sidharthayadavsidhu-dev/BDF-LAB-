{
  "info": {
    "_postman_id": "f2e54ca7-9c4a-48ef-99f5-b2b927ef9ecf",
    "name": "Books API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "bookId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "GET all books",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/books/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns all seeded books', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET one book",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/books/1/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns the requested book', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().id).to.eql(1);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET missing book (404)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/books/99999999/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 404 for a missing book', function () {",
              "  pm.response.to.have.status(404);",
              "  pm.expect(pm.response.json().error).to.eql('Book not found');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST create book",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman test book\",\n  \"author\": \"Postman\",\n  \"price\": 20,\n  \"pages\": 200\n}"
        },
        "url": "{{baseUrl}}/books/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('creates a book', function () {",
              "  pm.response.to.have.status(201);",
              "  const book = pm.response.json();",
              "  pm.expect(book.title).to.eql('Postman test book');",
              "  pm.collectionVariables.set('bookId', book.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT update book",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated Postman test book\",\n  \"author\": \"Postman\",\n  \"price\": 25,\n  \"pages\": 210\n}"
        },
        "url": "{{baseUrl}}/books/{{bookId}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('updates the book', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().title).to.eql('Updated Postman test book');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE remove book",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/books/{{bookId}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('deletes the book', function () {",
              "  pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
